# ============================================================
# MEDIKIOSK BACKEND – Environment Variables
# ============================================================

# ── Server ──────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ── Database (MongoDB) ───────────────────────────────────────
# Local:
MONGO_URI=mongodb://127.0.0.1:27017/medikiosk
# Atlas (uncomment and replace if using cloud):
# MONGO_URI=mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/medikiosk?retryWrites=true&w=majority

# ── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# ── CORS ─────────────────────────────────────────────────────
CLIENT_ORIGIN=http://localhost:5174

# ── AI Service (Python / FastAPI) ────────────────────────────
AI_SERVICE_URL=http://localhost:8000
